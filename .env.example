# Heimdall configuration for `docker compose` (copy to .env; .env is gitignored).
# Never commit a real token.

# Base URL of your GitLab instance (required unless GITLAB_MOCK=1).
GITLAB_URL=https://gitlab.example.com

# GitLab token sent as "Authorization: Bearer ..."; read_api scope is enough.
# Stays in the backend: never sent to the browser, never logged.
GITLAB_TOKEN=

# Full path of the parent GitLab group whose depth-1/2 sub-groups are offered (required).
ROOT_GROUP=org/delivery

# Noun used for groups in the UI (SPEC Amendment A.2).
GROUP_TERM=ART

# 1 = serve built-in fixture data instead of calling GitLab (no URL/token needed).
GITLAB_MOCK=0
